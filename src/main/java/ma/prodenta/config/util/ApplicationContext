package ma.prodenta.config;

import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import ma.prodenta.mvc.controllers.modules.auth.api.AuthController;
import ma.prodenta.mvc.controllers.modules.auth.swing_Implementation.LoginControllerImpl;
import ma.prodenta.mvc.controllers.modules.patient.api.PatientController;
import ma.prodenta.mvc.controllers.modules.patient.batch_implentation.PatientControllerImpl;
import ma.prodenta.repository.modules.patient.api.PatientDao;
import ma.prodenta.repository.modules.patient.fileBase_implementation.PatientDAOImpl;
import ma.prodenta.service.modules.auth.api.AuthService;
import ma.prodenta.service.modules.auth.baseImplementation.InMemoryAuthService;
import ma.prodenta.service.modules.auth.baseImplementation.JdbcAuthService;
import ma.prodenta.repository.modules.auth.api.UtilisateurDao;
import ma.prodenta.repository.modules.auth.fileBase_implementation.UtilisateurDAOImpl;
import ma.prodenta.service.modules.patient.api.PatientService;
import ma.prodenta.service.modules.patient.baseImplementation.PatientServiceImpl;

public class ApplicationContext {

    private static final Map<Class<?>, Object> SINGLETONS = new ConcurrentHashMap<>();

    @SuppressWarnings("unchecked")
    public static <T> T getBean(Class<T> type) {
        return (T) SINGLETONS.computeIfAbsent(type, ApplicationContext::createBean);
    }

    private static Object createBean(Class<?> type) {
        if (type.equals(PatientController.class)) {
            PatientService service = getBean(PatientService.class);
            return new PatientControllerImpl(service);
        }
        if (type.equals(PatientService.class)) {
            PatientDao dao = getBean(PatientDao.class);
            return new PatientServiceImpl(dao);
        }
        if (type.equals(PatientDao.class)) {
            return new PatientDAOImpl();
        }
        if (type.equals(AuthService.class)) {
            UtilisateurDao utilisateurDao = getBean(UtilisateurDao.class);
            return new JdbcAuthService(utilisateurDao);
        }
        if (type.equals(AuthController.class)) {
            AuthService authService = getBean(AuthService.class);
            return new LoginControllerImpl(authService);
        }
        if (type.equals(UtilisateurDao.class)) {
            return new UtilisateurDAOImpl();
        }
        throw new IllegalArgumentException("Bean introuvable pour " + type.getName());
    }

}
